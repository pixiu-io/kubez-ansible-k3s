{% set role_desc = k3s_role ~ (' (join=' ~ (k3s_join_server | bool) ~ ')' if k3s_role == 'server' else '') %}
# k3s configuration generated by kubez-ansible
# role: {{ role_desc }}
node-name: "{{ inventory_hostname }}"
node-ip: "{{ api_interface_address }}"
data-dir: "{{ k3s_data_dir }}"
{% if k3s_role == 'server' %}
cluster-cidr: "{{ cluster_cidr }}"
service-cidr: "{{ service_cidr }}"
cluster-dns: "{{ cluster_dns }}"
# CNI 由 kubez-ansible 的 apply 阶段统一安装（flannel/calico/cilium），禁用 k3s 内置 flannel
flannel-backend: "none"
disable-network-policy: true
# 禁用与 kubez-ansible 应用重复的内置组件（metrics-server/local-storage 等由 apply 阶段安装）
disable:
{% for item in k3s_disable_components %}
  - {{ item }}
{% endfor %}
{% if kube_proxy_mode != 'iptables' %}
kube-proxy-arg:
  - "proxy-mode={{ kube_proxy_mode }}"
{% endif %}
tls-san:
  - "{{ api_interface_address }}"
{% if kube_vip_address | string | length > 0 %}
  - "{{ kube_vip_address }}"
{% endif %}
{% if (groups['kube-master'] | length > 1) and not (k3s_join_server | bool) %}
# 多 master 时由第一个 server 启用内嵌 etcd（HA 模式）；加入节点不可同时带 server 参数
cluster-init: true
{% endif %}
{% if k3s_join_server | bool %}
# 加入已有控制面
server: "https://{{ k3s_join_address }}{% if ':' not in k3s_join_address %}:6443{% endif %}"
token: "{{ k3s_token }}"
{% endif %}
{% else %}
# agent 只加入，不承载控制面
server: "https://{{ k3s_join_address }}{% if ':' not in k3s_join_address %}:6443{% endif %}"
token: "{{ k3s_token }}"
{% endif %}
